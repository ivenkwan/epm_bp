# JVM image for finance-core used by the local Kubernetes platform (Task 4).
# Build: docker build -f src/main/docker/Dockerfile.jvm -t finance-core:r0 services/finance-core
FROM registry.access.redhat.com/ubi9/openjdk-21:1.20

ENV JAVA_OPTS="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"

# Non-root uid 185 comes from the base image; no secrets are baked in.
COPY --chown=185:0 target/quarkus-app/lib/ /deployments/lib/
COPY --chown=185:0 target/quarkus-app/*.jar /deployments/
COPY --chown=185:0 target/quarkus-app/app/ /deployments/app/
COPY --chown=185:0 target/quarkus-app/quarkus/ /deployments/quarkus/

EXPOSE 8080
USER 185

ENTRYPOINT ["/bin/sh", "-c", "exec java $JAVA_OPTS -jar /deployments/quarkus-run.jar"]
