<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="toolchain-process-definitions"
             targetNamespace="https://kie.apache.org/bpmn/toolchain">
  <process id="toolchain_smoke" name="Toolchain smoke" isExecutable="true">
    <startEvent id="start" name="Start" />
    <userTask id="wait" name="Synthetic wait" />
    <endEvent id="end" name="End" />
    <sequenceFlow id="start-to-wait" sourceRef="start" targetRef="wait" />
    <sequenceFlow id="wait-to-end" sourceRef="wait" targetRef="end" />
  </process>
</definitions>
