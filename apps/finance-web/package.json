{
  "name": "@epm/finance-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Accessible strict-TypeScript web application for the governed finance platform.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "generate:api": "openapi-typescript ../../services/finance-core/src/main/openapi/common-v1.yaml --output src/api/generated/common-v1.ts"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/react": "4.10.2",
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.7",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.9.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "7.1.11",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
